<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WidgetSamples</RootNamespace>
    <IvySource>true</IvySource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ivy.Tendril.Widgets.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Static assets served by WebViewerProxy.cs (proxied-page agent, service worker, screenshot lib). -->
    <Content Include="proxy-assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
