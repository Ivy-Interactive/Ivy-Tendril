<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);IncludeDependenciesInPackage</TargetsForTfmSpecificBuildOutput>
    <PackageId>Ivy.Tendril.Plugin.Linear</PackageId>
    <Title>Linear</Title>
    <Authors>Ivy Interactive</Authors>
    <Company>Ivy Interactive</Company>
    <Description>Linear integration for Ivy Tendril — import issues from Linear into Tendril plans</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Ivy-Interactive/Ivy-Tendril</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ivy-Interactive/Ivy-Tendril</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="tendril.json" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="StrawberryShake.Transport.Http" Version="16.0.7" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Ivy.Tendril.Plugin.Extended.Abstractions/Ivy.Tendril.Plugin.Extended.Abstractions.csproj"
                      PrivateAssets="all"
                      ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Bundle dependency DLLs into the NuGet package so the plugin host can load them.
       Tendril installs plugins by extracting the .nupkg directly — it doesn't run NuGet
       restore, so transitive dependencies must be physically present in the package.
       The ProjectReference above uses ExcludeAssets="runtime" so only this plugin's own
       PackageReference dependencies end up in ReferenceCopyLocalPaths.
       We further exclude assemblies shared with the host at runtime. -->
  <Target Name="IncludeDependenciesInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <BuildOutputInPackage Include="@(ReferenceCopyLocalPaths)" Condition="
        '%(ReferenceCopyLocalPaths.Extension)' == '.dll'
        And '%(ReferenceCopyLocalPaths.NuGetPackageId)' != ''
        And !$([System.String]::new('%(ReferenceCopyLocalPaths.NuGetPackageId)').StartsWith('Ivy'))
        And !$([System.String]::new('%(ReferenceCopyLocalPaths.NuGetPackageId)').StartsWith('Microsoft.Extensions.DependencyInjection'))
        And '%(ReferenceCopyLocalPaths.NuGetPackageId)' != 'Microsoft.Extensions.Logging.Abstractions'
      " />
    </ItemGroup>
  </Target>

</Project>
